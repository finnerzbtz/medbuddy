{
  "name": "reminduh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/mvp/build-offline.mjs",
    "preview": "vite preview",
    "assets:build": "node rebuild/scripts/build.mjs",
    "assets:optimize": "node rebuild/scripts/optimize.mjs",
    "assets:check": "node rebuild/scripts/validate.mjs",
    "assets:test": "node rebuild/scripts/browser-test.mjs",
    "test:unit": "node scripts/mvp/domain-tests.mjs",
    "test:e2e": "node scripts/mvp/browser-test.mjs",
    "test": "npm run test:unit && npm run test:e2e && npm run test:companion && npm run test:room && npm run test:polish && npm run test:garden && npm run test:tea && npm run test:reminders && npm run test:environment && npm run test:accessibility && npm run test:market && npm run test:celebration && npm run test:room-shop && npm run test:sand && npm run test:audio && npm run test:music-loop && npm run test:wisdom && npm run test:voice && npm run test:voice-auto",
    "format": "prettier --write src scripts/mvp rebuild/scripts",
    "format:check": "prettier --check src scripts/mvp rebuild/scripts",
    "test:companion": "node scripts/mvp/companion-browser-test.mjs",
    "test:room": "node scripts/mvp/room-browser-test.mjs",
    "test:polish": "node scripts/mvp/polish-browser-test.mjs",
    "test:garden": "node scripts/mvp/garden-browser-test.mjs",
    "test:tea": "node scripts/mvp/tea-browser-test.mjs",
    "test:reminders": "node scripts/mvp/reminder-browser-test.mjs",
    "test:environment": "node scripts/mvp/environment-browser-test.mjs",
    "test:accessibility": "node scripts/mvp/accessibility-browser-test.mjs && node scripts/mvp/accessibility-audit.mjs",
    "test:market": "node scripts/mvp/market-browser-test.mjs",
    "test:celebration": "node scripts/mvp/celebration-browser-test.mjs",
    "test:room-shop": "node scripts/mvp/room-shop-browser-test.mjs && node scripts/mvp/room-object-browser-test.mjs",
    "test:room-offline": "node scripts/mvp/room-offline-browser-test.mjs",
    "test:sand": "node scripts/mvp/sand-browser-test.mjs",
    "audio:generate": "node scripts/mvp/audio-generate.mjs",
    "test:audio": "node scripts/mvp/audio-browser-test.mjs",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:simulator": "node scripts/ios/build.mjs simulator",
    "ios:archive": "node scripts/ios/build.mjs archive",
    "test:ios-domain": "node scripts/ios/reminder-tests.mjs",
    "test:wisdom": "node scripts/mvp/wisdom-browser-test.mjs",
    "test:wisdom-offline": "node scripts/mvp/wisdom-offline-browser-test.mjs",
    "voice:generate": "node scripts/mvp/voice-generate.mjs",
    "test:voice": "node scripts/mvp/voice-browser-test.mjs",
    "voice:design": "node scripts/mvp/voice-design.mjs",
    "voice:save-designs": "node scripts/mvp/voice-save-designs.mjs",
    "test:voice-assets": "python3 scripts/mvp/voice-asset-check.py",
    "test:voice-auto": "node scripts/mvp/voice-auto-browser-test.mjs",
    "test:leaves-music": "node scripts/mvp/leaves-music-browser-test.mjs",
    "test:ios-leaves": "xcrun swiftc ios/App/App/LeafLedger.swift scripts/ios/leaf-ledger-tests.swift -o /tmp/reminduh-leaf-tests && /tmp/reminduh-leaf-tests",
    "test:music-loop": "node scripts/mvp/music-loop-browser-test.mjs",
    "test:music-update": "npm run build && node scripts/mvp/music-update-browser-test.mjs",
    "test:record-notes": "node scripts/mvp/record-notes-browser-test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/backend/migrate.mjs",
    "test:cloud": "node scripts/backend/integration-test.mjs && node scripts/backend/browser-test.mjs",
    "test:medication-names": "node scripts/mvp/medication-name-tests.mjs",
    "test:release-a": "node scripts/release-a/contract-tests.mjs && node scripts/release-a/cloud-version-tests.mjs && node scripts/ios/reminder-tests.mjs && node scripts/mvp/domain-tests.mjs",
    "test:release-a-ui": "node scripts/release-a/quiet-break-browser-test.mjs && node scripts/release-a/ui-browser-test.mjs && node scripts/release-a/activity-browser-test.mjs",
    "check:repo": "node scripts/release/check-repository.mjs",
    "check:release": "npm run check:repo && npm run test:release-a && npm run assets:check && npm run build",
    "test:release-browser": "node scripts/release/browser-checks.mjs",
    "ios:beta": "node scripts/ios/build.mjs beta"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.1",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.460.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "three": "^0.170.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@capacitor/cli": "8.5.1",
    "@gltf-transform/cli": "^4.3.0",
    "@playwright/test": "^1.58.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.25.12",
    "meshoptimizer": "0.18.1",
    "playwright": "^1.58.2",
    "prettier": "3.6.2",
    "sharp": "0.35.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
