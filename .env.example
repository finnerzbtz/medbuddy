# Public browser/native endpoints only. Both are required to enable accounts.
# Copy to .env.development.local for the development branch.
# Use .env.production.local for production builds and Capacitor sync.
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_URL=

# Never put DATABASE_URL, provider API keys or service-role credentials in VITE_*.
# Migration credentials belong in the ignored .env.backend.<environment>.local.
# See docs/backend/Auth-and-Sync.md.
